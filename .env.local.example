# Supabase — copy this file to `.env.local` and fill in the values from your
# existing project's dashboard (Settings → API).
#
# Both values are safe to expose in the browser: the anon key is designed to be
# public and is protected by Row Level Security. NEVER put the service_role key
# here or anywhere client-side.
#
# If these are left unset, the app runs exactly as before — progress is kept in
# localStorage only and all cloud sync / sign-in features quietly no-op.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
